# Server Config
PORT=5000
NODE_ENV=development

# MongoDB - Use Atlas or local
# For local: mongodb://localhost:27017/arvi
# For memory fallback (no DB needed), leave empty and server will use in-memory store
MONGODB_URI=mongodb://localhost:27017/arvi
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/arvi

# JWT
JWT_SECRET=arvi_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRE=30d

# Frontend URL for CORS
CLIENT_URL=http://localhost:3000

# Admin seed
ADMIN_EMAIL=admin@arvibaby.com
ADMIN_PASSWORD=Admin@123
