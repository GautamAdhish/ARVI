{
  "name": "arvi-fullstack",
  "version": "2.0.0",
  "description": "ARVI - Modern Feeding Collection - Full Stack MERN E-commerce",
  "main": "server/src/index.js",
  "scripts": {
    "start": "node server/src/index.js",
    "server": "cd server && npm run dev",
    "client": "cd arvi-mern && npm start",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install-all": "npm install && cd server && npm install && cd ../arvi-mern && npm install",
    "seed": "cd server && npm run seed",
    "build": "cd arvi-mern && npm run build",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GautamAdhish/ARVI.git"
  },
  "keywords": ["mern", "ecommerce", "baby-products", "arvi", "fullstack"],
  "author": "ARVI Team",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
